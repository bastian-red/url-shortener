{
  "name": "@links/link-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Link policy: slug generation, reserved slugs, destination URL rules. Pure; imported by the API and the web app's form.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@links/shared": "workspace:*"
  },
  "devDependencies": {
    "@links/config": "workspace:*",
    "@types/node": "^20.17.6",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

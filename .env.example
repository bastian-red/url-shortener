# url-shortener environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#   sed -i "s|^VISITOR_HASH_SECRET=|VISITOR_HASH_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json. That is not a convention, it is a
# gate: `node scripts/env-contract.mjs` fails the commit if this file, the source
# (TypeScript AND the Go redirect service) and turbo.json disagree in any of four
# directions. Turborepo 2 runs in strict environment mode, so a name turbo.json
# forgets is stripped from the child process silently.
#
# Nothing loads this file on its own. `pnpm dev` runs scripts/dev.sh, which
# sources it, checks the secrets and preflights the datastores before handing off
# to turbo.

# --- Core ---

# Next.js and Nest read this themselves. Leave it unset for local development;
# `next build` must not see "development" or it pulls the dev React runtime and
# prerendering breaks.
NODE_ENV=

# Reported by every service's /health so a running process can be identified.
APP_VERSION=0.1.0

# --- Database (Postgres) ---

# Ports are deliberately off the defaults. The dev host runs a system PostgreSQL
# on 5432 and the sibling portfolio stacks own 5433-5441 and 6380-6387, so this
# project takes 5442/6388 and every URL below matches.
DATABASE_URL=postgresql://links:links@localhost:5442/links?schema=public

# Prisma migrations cannot run through a transaction-mode pooler. Locally this is
# the same server; the two names exist so the split is possible without a code
# change.
DIRECT_DATABASE_URL=postgresql://links:links@localhost:5442/links?schema=public

# --- Redis ---

# On the hot path: the link cache every redirect answers from, the click-limit
# counters, the rate-limit buckets and the clicks stream. Compose runs it with
# append-only persistence for that reason.
REDIS_URL=redis://localhost:6388

# --- Redirect service (Go, services/redirect) ---

REDIRECT_PORT=8080

# The public origin short links are built on. Must differ from APP_BASE_URL:
# this origin is answered by the Go service, the app's by Next.js.
SHORT_BASE_URL=http://localhost:8080

# How many reverse proxies sit in front of the redirect service. 0 ignores
# X-Forwarded-For entirely, which is the only safe value with no proxy: the
# header is otherwise whatever the client typed, and it picks both the
# rate-limit bucket and the country. Behind one load balancer, set 1.
TRUST_PROXY_HOPS=0

# Per client address, GCRA: this many redirects per minute sustained, plus a
# burst on top. A person clicking links never comes close; a script does.
RATE_LIMIT_REDIRECT=600
RATE_LIMIT_REDIRECT_BURST=60

# How long a link record stays in Redis after it was last written. The API and
# the redirect service both read this, so a write-through record and a
# miss-populated one live equally long.
LINK_CACHE_TTL_SECONDS=86400

# How long an unknown slug is remembered as unknown. Short, because a slug that
# 404s now may be created in a minute; long enough that a scanner cycling random
# slugs costs Postgres one query per slug per minute, not one per request.
NEGATIVE_CACHE_SECONDS=60

# Bound on the clicks stream (XADD MAXLEN ~). Processed entries are deleted, so
# this only matters while the worker is down: past it, the oldest unprocessed
# clicks are trimmed rather than letting Redis grow without bound.
STREAM_MAXLEN=1000000

# --- Click worker (services/click-worker) ---

# Key the daily visitor-hash keys are derived from. At least 16 characters;
# scripts/dev.sh refuses to start without one. Never stored; rotating it only
# means today's visitors count as new.
VISITOR_HASH_SECRET=

# A MaxMind-format city database. Empty means the repo's data/dbip-city-lite.mmdb,
# which `pnpm geo:download` fetches (DB-IP City Lite, CC BY 4.0, no account).
GEOIP_DB_PATH=

WORKER_HEALTH_PORT=4100

# Clicks per transaction, and how long one read waits for the stream.
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=200

# A pending entry idle this long is assumed orphaned by a dead consumer and
# reclaimed by a live one.
WORKER_CLAIM_IDLE_MS=30000

# --- API service ---

API_PORT=4000

# PORT wins over API_PORT, matching what every container runtime injects. Leave it
# empty locally: the web app reads PORT too.
PORT=

# Where the web app's server code reaches the API. Server-side only: the browser
# never calls the API, so there is no NEXT_PUBLIC_ API URL and no CORS surface.
API_BASE_URL=http://localhost:4000

# Where the API reaches the other two services for GET /status.
REDIRECT_INTERNAL_URL=http://localhost:8080
WORKER_INTERNAL_URL=http://localhost:4100

# How long a report over a range that has fully closed stays cached. A range
# ending in the current hour is never cached.
ANALYTICS_CACHE_TTL_SECONDS=60

# --- HTTP rate limits on the API (requests per minute) ---

# Signed-in calls are counted per user, sign-in and sign-up per address. The two
# special budgets must stay below the global one or the API refuses to start.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
RATE_LIMIT_CREATE=30

# --- Web app ---

WEB_PORT=3000

# This app's own origin.
APP_BASE_URL=http://localhost:3000

# --- Auth ---

# One value, two processes: the web app mints a short-lived HS256 service token
# with it and the API verifies it. At least 16 characters.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3000

{
  "$schema": "https://turbo.build/schema.json",

  // Turborepo 2 defaults to envMode: "strict". A task's child process sees only
  // the names listed below plus turbo's own system allowlist; everything else is
  // stripped with no warning. That is left on deliberately -- it is the reason
  // scripts/env-contract.mjs can be a meaningful gate -- but it does mean a name
  // this file forgets is a name the running app never sees. The Go redirect
  // service is launched by turbo too, so its os.Getenv reads count (the
  // contract scans .go files).
  //
  // Verify with: turbo run dev --dry=json   (it reports globalEnvMode).

  // globalEnv values are hashed into the cache key, so this list is only for
  // names that change what gets BUILT. A secret must never appear here, because
  // its value would become part of a hash input.
  "globalEnv": ["API_BASE_URL", "NODE_ENV"],

  // Runtime configuration. Read by the process, never baked into an artefact,
  // so a change here must not invalidate a cached build.
  "globalPassThroughEnv": [
    "ANALYTICS_CACHE_TTL_SECONDS",
    "API_PORT",
    "APP_BASE_URL",
    "APP_VERSION",
    "AUTH_SECRET",
    "AUTH_URL",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "GEOIP_DB_PATH",
    "LINK_CACHE_TTL_SECONDS",
    "NEGATIVE_CACHE_SECONDS",
    "PORT",
    "RATE_LIMIT_AUTH",
    "RATE_LIMIT_CREATE",
    "RATE_LIMIT_GLOBAL",
    "RATE_LIMIT_REDIRECT",
    "RATE_LIMIT_REDIRECT_BURST",
    "REDIRECT_INTERNAL_URL",
    "REDIRECT_PORT",
    "REDIS_URL",
    "SHORT_BASE_URL",
    "STREAM_MAXLEN",
    "TRUST_PROXY_HOPS",
    "VISITOR_HASH_SECRET",
    "WEB_PORT",
    "WORKER_BATCH_SIZE",
    "WORKER_BLOCK_MS",
    "WORKER_CLAIM_IDLE_MS",
    "WORKER_HEALTH_PORT",
    "WORKER_INTERNAL_URL"
  ],

  "tasks": {
    // dependsOn ^build because every app imports workspace packages through
    // dist/. On a machine that has built once this looks unnecessary; on a clean
    // checkout it is the difference between a working command and a stack trace
    // about a missing module.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "bin/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
